@startuml SeqUC03_IscriviTeam
title Diagramma di Sequenza — UC03 Iscrivi Team a Hackathon\nPattern coinvolti: State (verifica), Observer (TEAM_ISCRITTO)

' ----- Convenzioni di rendering -----
skinparam shadowing false
skinparam roundCorner 8
skinparam sequenceMessageAlign center
skinparam sequence {
  ArrowColor              #2C3E50
  LifeLineBorderColor     #2C3E50
  ParticipantBorderColor  #2C3E50
  ActorBorderColor        #2C3E50
  ParticipantFontSize     11
  ParticipantBackgroundColor<<boundary>> #E3F2FD
  ParticipantBackgroundColor<<control>>  #FFF8E1
  ParticipantBackgroundColor<<entity>>   #E8F5E9
  ParticipantBackgroundColor<<state>>    #FFF3E0
  ParticipantBackgroundColor<<observer>> #E1F5FE
}

actor       "Membro Team"               as MT
participant ":IscriviTeamBoundary"      as B   <<boundary>>
participant ":IscriviTeamControl"       as C   <<control>>
participant ":HackHub"                  as Hub <<entity>>
participant "h:Hackathon"               as H   <<entity>>
participant "stato:StatoHackathon"      as S   <<state>>
participant "t:Team"                    as T   <<entity>>
participant "pub:NotificaPublisher"     as Pub <<observer>>

== Selezione hackathon ==

MT -> B : richiediHackathonDisponibili()
activate B
B  -> C : elencaHackathonInIscrizione()
activate C
C  -> Hub : hackathonInIscrizione()
activate Hub
Hub --> C : lista
deactivate Hub
C  --> B : lista
deactivate C
B  --> MT : mostraLista(lista)
deactivate B

== Iscrizione ==

MT -> B : selezionaHackathon(idH)
activate B
B  -> C : richiediIscrizione(idH, utente)
activate C

C  -> Hub : trovaTeamDi(utente)
activate Hub
Hub --> C : t
deactivate Hub

opt utente non in alcun team
    C  --> B : esitoErrore("Non sei membro di un team")
    B  --> MT : mostraErrore(...)
end

C  -> Hub : trovaHackathon(idH)
activate Hub
Hub --> C : h
deactivate Hub

C  -> H : puoiIscrivereTeam()
activate H
H  -> S : puoiIscrivereTeam()
activate S
S  --> H : true / false
deactivate S
H  --> C : esito
deactivate H

alt iscrizioni ammesse
    C  -> H : verificaScadenza(adesso)
    activate H
    H  --> C : entroScadenza
    deactivate H

    C  -> T : numeroMembri()
    activate T
    T  --> C : k
    deactivate T

    alt k <= dimensioneMaxTeam(h) AND entroScadenza AND non già iscritto
        C  -> H : iscriviTeam(t)
        activate H
        H  -> H : aggiungiPartecipante(t)

        H  -> Pub : aggiorna(this, TEAM_ISCRITTO, t)
        activate Pub
        Pub --> H : ok
        deactivate Pub

        H  --> C : ok
        deactivate H
        C  --> B : esitoSuccesso(h, t)
        B  --> MT : mostraConferma()
    else vincoli non rispettati
        C  --> B : esitoErrore(motivo)
        B  --> MT : mostraErrore(motivo)
    end
else iscrizioni non ammesse (stato ≠ InIscrizione o scadenza superata)
    C  --> B : esitoErrore("Iscrizioni chiuse")
    B  --> MT : mostraErrore("Iscrizioni chiuse")
end

deactivate C
deactivate B

note over S
  **State** — solo ``InIscrizione`` ritorna ``true``;
  gli altri stati ereditano ``false`` dal default in ``StatoHackathon``.
end note

@enduml
