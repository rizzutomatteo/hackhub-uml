@startuml SeqUC03_IscriviTeam
title Diagramma di Sequenza - UC03 Iscrivi Team a Hackathon\nPattern coinvolti: State (verifica), Observer (TEAM_ISCRITTO)

skinparam sequence {
  ArrowColor              #2C3E50
  LifeLineBorderColor     #2C3E50
  ParticipantBorderColor  #2C3E50
  ActorBorderColor        #2C3E50
  ParticipantBackgroundColor<<boundary>> #E3F2FD
  ParticipantBackgroundColor<<control>>  #FFF8E1
  ParticipantBackgroundColor<<entity>>   #E8F5E9
}

actor      "Membro Team"                                 as MT
boundary   ":IscriviTeamBoundary"                        as B   <<boundary>>
control    ":IscriviTeamControl"                         as C   <<control>>
entity     ":HackHub"                                    as Hub <<entity>>
entity     "h:Hackathon"                                 as H   <<entity>>
participant "<<State>>\nstato:StatoHackathon"             as S
entity     "t:Team"                                      as T   <<entity>>
participant "<<Observer>>\npub:NotificaPublisher"         as Pub

== Selezione hackathon ==

MT -> B : richiediHackathonDisponibili()
activate B
B  -> C : elencaHackathonInIscrizione()
activate C
C  -> Hub : trovaHackathonInIscrizione()
activate Hub
Hub --> C : lista
deactivate Hub
C  --> B : lista
deactivate C
B  --> MT : mostraLista(lista)
deactivate B

MT -> B : selezionaHackathon(idH)
activate B
B  -> C : richiediIscrizione(idH, utente)
activate C

== Risale al team del membro ==

C  -> Hub : trovaTeamDi(utente)
activate Hub
Hub --> C : t
deactivate Hub

opt utente non in alcun team
    C  --> B : esitoErrore("Non sei membro di un team")
    B  --> MT : mostraErrore(...)
end

C  -> Hub : trovaHackathon(idH)
activate Hub
Hub --> C : h
deactivate Hub

== Pattern State: verifica se è ammessa l'iscrizione ==

C  -> H : puoiIscrivereTeam()
activate H
H  -> S : puoiIscrivereTeam()
activate S
S  --> H : true / false
deactivate S
H  --> C : esito
deactivate H

alt iscrizioni ammesse
    note right of S
      **State** — solo lo stato concreto
      ``InIscrizione`` ritorna ``true``;
      tutti gli altri stati ritornano ``false``
      grazie al default in ``StatoHackathon``.
    end note

    C  -> H : verificaScadenza(adesso)
    activate H
    H  --> C : entroScadenza
    deactivate H

    C  -> T : numeroMembri()
    activate T
    T  --> C : k
    deactivate T

    alt k <= dimensioneMaxTeam(h) AND entroScadenza AND non già iscritto
        C  -> H : iscriviTeam(t)
        activate H
        H  -> H : aggiungiPartecipante(t)

        == Pattern Observer: notifica TEAM_ISCRITTO ==

        H  -> Pub : aggiorna(TEAM_ISCRITTO, h, t)
        activate Pub
        Pub -> Pub : creaNotifica(evento)\nnote: vedi UC02
        Pub --> H : ok
        deactivate Pub

        H  --> C : ok
        deactivate H
        C  --> B : esitoSuccesso(h, t)
        B  --> MT : mostraConferma()
    else vincoli non rispettati
        C  --> B : esitoErrore(motivo)
        B  --> MT : mostraErrore(motivo)
    end
else iscrizioni non ammesse (stato ≠ InIscrizione o scadenza superata)
    C  --> B : esitoErrore("Iscrizioni chiuse")
    B  --> MT : mostraErrore("Iscrizioni chiuse")
end

deactivate C
deactivate B

@enduml
