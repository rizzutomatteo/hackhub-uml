@startuml SeqUC05_ValutaSottomissione
title Diagramma di Sequenza — UC05 Valuta Sottomissione\nPattern coinvolti: State (verifica), Strategy (calcolo punteggio), Observer (VALUTAZIONI_COMPLETE)

' ----- Convenzioni di rendering -----
skinparam shadowing false
skinparam roundCorner 8
skinparam sequenceMessageAlign center
skinparam sequence {
  ArrowColor              #2C3E50
  LifeLineBorderColor     #2C3E50
  ParticipantBorderColor  #2C3E50
  ActorBorderColor        #2C3E50
  ParticipantFontSize     11
  ParticipantBackgroundColor<<boundary>>  #E3F2FD
  ParticipantBackgroundColor<<control>>   #FFF8E1
  ParticipantBackgroundColor<<entity>>    #E8F5E9
  ParticipantBackgroundColor<<state>>     #FFF3E0
  ParticipantBackgroundColor<<strategy>>  #FCE4EC
  ParticipantBackgroundColor<<observer>>  #E1F5FE
}

actor       "Giudice"                       as Giu
participant ":ValutaSottomissioneBoundary"  as B    <<boundary>>
participant ":ValutaSottomissioneControl"   as C    <<control>>
participant ":HackHub"                      as Hub  <<entity>>
participant "h:Hackathon"                   as H    <<entity>>
participant "stato:StatoHackathon"          as S    <<state>>
participant "s:Sottomissione"               as Sub  <<entity>>
participant "v:Valutazione"                 as V    <<entity>>
participant "str:StrategiaPunteggio"        as Str  <<strategy>>
participant "pub:NotificaPublisher"         as Pub  <<observer>>

== Lista sottomissioni da valutare ==

Giu -> B : richiediSottomissioni(idH)
activate B
B  -> C : elencaSottomissioniDaValutare(idH, giudice)
activate C
C  -> Hub : trovaHackathon(idH)
activate Hub
Hub --> C : h
deactivate Hub
C  -> H : sottomissioniNonValutateDa(giudice)
activate H
H  --> C : lista
deactivate H
C  --> B : lista
deactivate C
B  --> Giu : mostraLista(lista)
deactivate B

== Inserimento valutazione ==

Giu -> B : selezionaSottomissione(idS)
activate B
B  --> Giu : mostraDettagli(s)
deactivate B

Giu -> B : inserisciValutazione(idS, punteggio, giudizioScritto)
activate B
B  -> C : valuta(idS, giudice, punteggio, giudizioScritto)
activate C

C  -> H : puoiValutare()
activate H
H  -> S : puoiValutare()
activate S
S  --> H : esito
deactivate S
H  --> C : esito
deactivate H

alt stato = InValutazione
    C  -> C  : verificaRange(punteggio)\n[0..10]

    alt range valido
        create V
        C  -> V : <<create>>(giudice, punteggio, giudizioScritto, adesso)

        C  -> Sub : aggiungiValutazione(v)
        activate Sub

        == Pattern Strategy: ricalcolo punteggio aggregato ==

        Sub -> H : strategiaPunteggio()
        activate H
        H  --> Sub : str
        deactivate H

        Sub -> Str : calcola(valutazioni)
        activate Str
        Str --> Sub : punteggioAggregato
        deactivate Str

        Sub -> Sub : aggiornaPunteggioAggregato(p)
        deactivate Sub

        == Eventuale VALUTAZIONI_COMPLETE ==

        C  -> H : tutteSottomissioniValutate()
        activate H
        H  --> C : flag
        deactivate H

        opt flag = true
            C  -> H : notifica(VALUTAZIONI_COMPLETE, null)
            activate H
            H  -> Pub : aggiorna(this, VALUTAZIONI_COMPLETE, null)
            activate Pub
            Pub --> H : ok
            deactivate Pub
            deactivate H
        end

        C  --> B : esitoSuccesso(v)
        B  --> Giu : mostraConferma(v)
    else punteggio fuori range
        C  --> B : esitoErrore("Punteggio fuori range 0..10")
        B  --> Giu : mostraErrore(...)
    end
else stato ≠ InValutazione
    C  --> B : esitoErrore("Hackathon non in valutazione")
    B  --> Giu : mostraErrore(...)
end

deactivate C
deactivate B

note over Str
  **Strategy** — l'algoritmo è intercambiabile a runtime
  (default: ``MediaSemplice``). ``Sottomissione`` non conosce
  la formula, solo l'interfaccia ``StrategiaPunteggio``.
end note

@enduml
