@startuml SeqUC04_InviaSottomissione
title Diagramma di Sequenza — UC04 Invia Sottomissione\nPattern coinvolti: State (verifica), Observer + Factory Method (notifica giudici)

' ----- Convenzioni di rendering -----
skinparam shadowing false
skinparam roundCorner 8
skinparam sequenceMessageAlign center
skinparam sequence {
  ArrowColor              #2C3E50
  LifeLineBorderColor     #2C3E50
  ParticipantBorderColor  #2C3E50
  ActorBorderColor        #2C3E50
  ParticipantFontSize     11
  ParticipantBackgroundColor<<boundary>> #E3F2FD
  ParticipantBackgroundColor<<control>>  #FFF8E1
  ParticipantBackgroundColor<<entity>>   #E8F5E9
  ParticipantBackgroundColor<<state>>    #FFF3E0
  ParticipantBackgroundColor<<observer>> #E1F5FE
  ParticipantBackgroundColor<<factory>>  #F3E5F5
}

actor       "Membro Team"                 as MT
participant ":InviaSottomissioneBoundary" as B    <<boundary>>
participant ":InviaSottomissioneControl"  as C    <<control>>
participant ":HackHub"                    as Hub  <<entity>>
participant "t:Team"                      as T    <<entity>>
participant "h:Hackathon"                 as H    <<entity>>
participant "stato:StatoHackathon"        as S    <<state>>
participant "s:Sottomissione"             as Sub  <<entity>>
participant "pub:NotificaPublisher"       as Pub  <<observer>>
participant ":NotificaConsole"            as Fac  <<factory>>

== Apertura form ==

MT -> B : apriFormSottomissione(idH)
activate B
B  -> C : preparaForm(idH, utente)
activate C
C  -> Hub : trovaTeamDi(utente)
activate Hub
Hub --> C : t
deactivate Hub
C  -> Hub : trovaHackathon(idH)
activate Hub
Hub --> C : h
deactivate Hub
C  --> B : datiForm(t, h)
deactivate C
B  --> MT : mostraForm(t, h)
deactivate B

== Invio della sottomissione ==

MT -> B : inviaSottomissione(titolo, descrizione, link)
activate B
B  -> C : creaSottomissione(t, h, titolo, descrizione, link)
activate C

C  -> H : puoiSottomettere()
activate H
H  -> S : puoiSottomettere()
activate S
S  --> H : esito
deactivate S
H  --> C : esito
deactivate H

alt stato = InCorso
    C  -> H : iscrizioneAttiva(t)
    activate H
    H  --> C : true / false
    deactivate H

    alt team iscritto e non scaduto
        C  -> H : sottomissioneEsistente(t)
        activate H
        H  --> C : exists?
        deactivate H

        opt sostituzione esistente (UC15 Aggiorna Sottomissione)
            C  -> Sub : marcaSostituita()
        end

        create Sub
        C  -> Sub : <<create>>(t, h, titolo, descrizione, link, adesso)

        C  -> H : aggiungiSottomissione(s)
        activate H

        H  -> Pub : aggiorna(this, SOTTOMISSIONE_RICEVUTA, s)
        activate Pub
        Pub -> Fac : creaNotifica(evento, giudice(h), contenuto)
        activate Fac
        create "n:Notifica" as N
        Fac -> N : <<create>>
        Fac --> Pub : n
        deactivate Fac
        Pub -> N : invia()
        deactivate Pub

        H  --> C : ok
        deactivate H

        C  --> B : esitoSuccesso(s)
        B  --> MT : mostraConferma(s)
    else team non iscritto o scadenza superata
        C  --> B : esitoErrore(motivo)
        B  --> MT : mostraErrore(motivo)
    end
else stato ≠ InCorso
    C  --> B : esitoErrore("Sottomissioni non aperte")
    B  --> MT : mostraErrore("Sottomissioni non aperte")
end

deactivate C
deactivate B

note over S
  **State** — solo ``InCorso`` consente la sottomissione.
  Gli altri stati ereditano ``false`` dall'interfaccia ``StatoHackathon``.
end note

note over Pub, Fac
  L'integrazione **Observer + Factory Method** centralizza
  la creazione polimorfa della notifica (console, email, push, …).
  Anti-pattern evitato: ``new`` di sottoclassi sparso nei control.
end note

@enduml
